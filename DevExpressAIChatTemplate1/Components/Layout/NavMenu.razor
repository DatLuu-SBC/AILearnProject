@using DevExpress.Images.Blazor
@inject NavigationManager NavigationManager
@implements IDisposable

<div>
    <DxMenu Orientation="@Orientation.Vertical" CssClass="menu">
        <Items>
            <DxMenuItem NavigateUrl="./" Text="Home" CssClass="@MenuItemCssClass("")" IconUrl="@Icon.Home"></DxMenuItem>
            <DxMenuItem NavigateUrl="./upload" Text="Upload Document" CssClass="@MenuItemCssClass("counter")" IconUrl="@Icon.FolderArrowUp"></DxMenuItem>
            <DxMenuItem NavigateUrl="./weather" Text="Weather" CssClass="@MenuItemCssClass("weather")" IconUrl="@Icon.WeatherPartlyCloudy"></DxMenuItem>
            <DxMenuItem NavigateUrl="./aichat" Text="AI Chat" CssClass="@MenuItemCssClass("aichat")" IconUrl="@Icon.ChatAiSparkle"></DxMenuItem>
        </Items>
    </DxMenu>
</div>

@code {
    private string? currentPage;

    protected override void OnInitialized() {
        currentPage = GetCurrentPage();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        currentPage = GetCurrentPage();
        InvokeAsync(StateHasChanged);
    }

    private string? MenuItemCssClass(string itemPath) {
        return string.Equals(currentPage, itemPath, StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : null;
    }

    private string GetCurrentPage() => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];

    public void Dispose() {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
